---
import { getCollection } from 'astro:content';
// Component Imports
import CallToAction from '../components/CallToAction.astro';
// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Skills from '../components/Skills.astro';
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Content Fetching: Featured projects from the `projects` collection
const featuredProjects = (await getCollection('projects'))
	.filter((p) => p.data.featured)
	.sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999))
	.slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
    <div class="stack gap-20 lg:gap-48">
        <div class="wrapper stack gap-8 lg:gap-20">
            <header class="hero">
                <Hero
                    title="Hi — I'm Kiren van den Brandeler"
                    tagline="Multidisciplinary Engineer & Designer — PLC/Robotics · Engineering · Industrial Design"
                    align="start"
                >
                    <div class="roles">
                        <Pill><Icon icon="cpu" size="1.33em" /> PLC & Robotics</Pill>
                        <Pill><Icon icon="terminal-window" size="1.33em" /> Engineering</Pill>
                        <Pill><Icon icon="pencil-line" size="1.33em" /> Industrial Design</Pill>
                    </div>
                </Hero>

                <img
                    alt="Portrait of Kiren van den Brandeler"
                    width="480"
                    height="620"
                    src="/assets/portrait.jpg"
                />
            </header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
            <section class="section with-background with-cta">
                <header class="section-header stack gap-2 lg:gap-4">
                    <h3>Featured Projects</h3>
                    <p>Explore my latest mechatronics engineering work, CAD designs, and automated system implementations.</p>
                </header>

                <div class="gallery">
                    <Grid variant="offset">
                        {
                            featuredProjects.map((project) => (
                                <li>
                                    <PortfolioPreview project={project} />
                                </li>
                            ))
                        }
                    </Grid>
                </div>

                <div class="cta">
                    <CallToAction href="/work/">
                        View Portfolio
                        <Icon icon="arrow-right" size="1.2em" />
                    </CallToAction>
                </div>
            </section>

            <section class="section quick-nav cards-section">
            	<header class="section-header stack gap-2 lg:gap-4">
            		<h3>Explore by Category</h3>
            		<p>Choose a track for your background: industry systems, side-builds, or academic design research.</p>
            	</header>

            	<div class="card-grid">
            		<a class="category-card work" href="/work/">
            			<div class="icon-card"><Icon icon="terminal-window" size="1.5em" /></div>
            			<div class="card-content">
            				<p class="eyebrow">Work</p>
            				<h4>Professional engineering portfolios</h4>
            				<p>Industry automation, PLC controls, and manufacturing-ready project delivery.</p>
            				<span class="link-text">View Work projects <Icon icon="arrow-right" size="1rem" /></span>
            			</div>
            		</a>

            		<a class="category-card personal" href="/personal/">
            			<div class="icon-card"><Icon icon="rocket-launch" size="1.5em" /></div>
            			<div class="card-content">
            				<p class="eyebrow">Personal</p>
            				<h4>DIY builds and experimentations</h4>
            				<p>Featured work includes my Arduino stop-motion motion controller and other self-directed systems.</p>
            				<span class="link-text">Explore Personal projects <Icon icon="arrow-right" size="1rem" /></span>
            			</div>
            		</a>

            		<a class="category-card studies" href="/studies/">
            			<div class="icon-card"><Icon icon="pencil-line" size="1.5em" /></div>
            			<div class="card-content">
            				<p class="eyebrow">Studies</p>
            				<h4>Research, courses, and prototype design</h4>
            				<p>Explore design research like the Weaverbot 3D house printer and multidisciplinary course projects.</p>
            				<span class="link-text">See Studies projects <Icon icon="arrow-right" size="1rem" /></span>
            			</div>
            		</a>
            	</div>
            </section>

            <section class="section with-background bg-variant">
                <header class="section-header stack gap-2 lg:gap-4">
                    <h3>Technical Expertise</h3>
                    <p>
                        A summary of specialized tools, engineering standards, and software systems 
                        utilized throughout my academic and industry design projects.
                    </p>
                </header>

				<div class="gallery">
					<Grid variant="small">
						{
							['Medium', 'BuzzFeed', 'The Next Web', 'awwwards.', 'TechCrunch'].map((brand) => (
								<li class="mention-card">
									<p>{brand}</p>
								</li>
							))
						}
					</Grid>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */

	.card-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.category-card {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: stretch;
		gap: 1rem;
		padding: 1.5rem;
		min-height: 13rem;
		background: linear-gradient(180deg, rgba(31, 41, 55, 0.95), rgba(15, 23, 42, 0.95));
		border: 1px solid rgba(148, 163, 184, 0.15);
		border-radius: 1.5rem;
		text-decoration: none;
		color: inherit;
		box-shadow: var(--shadow-md);
		transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
	}

	.category-card:hover,
	.category-card:focus-visible {
		transform: translateY(-0.25rem);
		box-shadow: var(--shadow-lg);
		border-color: rgba(148, 163, 184, 0.3);
	}

	.category-card.work {
		background-image: radial-gradient(circle at top left, rgba(56, 189, 248, 0.14), transparent 45%);
	}

	.category-card.personal {
		background-image: radial-gradient(circle at top left, rgba(232, 121, 249, 0.14), transparent 45%);
	}

	.category-card.studies {
		background-image: radial-gradient(circle at top left, rgba(34, 211, 238, 0.14), transparent 45%);
	}

	.icon-card {
		display: grid;
		place-items: center;
		width: 4rem;
		height: 4rem;
		background: rgba(255, 255, 255, 0.08);
		border-radius: 1rem;
	}

	.card-content {
		display: grid;
		gap: 0.75rem;
	}

	.card-content h4 {
		margin: 0;
		font-size: var(--text-2xl);
	}

	.eyebrow {
		font-size: var(--text-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: var(--accent-light);
		margin: 0;
	}

	.link-text {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 700;
		color: var(--text-accent);
	}

	.link-text svg {
		transform: translateX(0);
		transition: transform 0.2s ease;
	}

	.category-card:hover .link-text svg {
		transform: translateX(0.25rem);
	}

	.card-content p {
		margin: 0;
		color: var(--gray-300);
	}

	@media (min-width: 50em) {
		.card-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.mention-card {
		display: flex;
		height: 7rem;
		justify-content: center;
		align-items: center;
		text-align: center;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	@media (min-width: 50em) {
		.mention-card {
			border-radius: 1.5rem;
			height: 9.5rem;
		}
	}
</style>
