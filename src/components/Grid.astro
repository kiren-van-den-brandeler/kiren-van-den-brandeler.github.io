---
interface Props {
	variant?: 'offset' | 'small';
}

const { variant } = Astro.props;
---

<ul class:list={['grid', { offset: variant === 'offset', small: variant === 'small' }]}>
	<slot />
</ul>

<style>
    .grid {
        display: grid;
        grid-auto-rows: 1fr;
        gap: 1rem;
        list-style: none;
        padding: 0;
    }

    .grid.small {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    /* Tablet and desktop screens */
    @media (min-width: 50em) {
        .grid {
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
        }

        .grid.offset {
            --row-offset: 7.5rem;
            padding-bottom: var(--row-offset);
        }

        .grid.offset > :global(:nth-child(odd)) {
            transform: translateY(var(--row-offset));
        }

        .grid.offset > :global(:last-child:nth-child(odd)) {
            grid-column: 2 / 3;
            transform: none;
        }

        /* ✅ FIX: Clean 3-column CSS Grid for the category cards */
        .grid.small {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }

        .grid.small > :global(*) {
            width: 100%;
            min-width: 0; /* Prevents text from forcing columns to stretch */
        }
    }
</style>