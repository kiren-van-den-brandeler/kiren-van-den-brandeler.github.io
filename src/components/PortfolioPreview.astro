---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { data, id } = Astro.props.project;
---

<a class="card" href={`/${data.category}/${id}`}>
	<span class="badge">{data.category}</span>
	<span class="title">{data.title}</span>
	<img src={data.coverImage} alt={data.description || ''} loading="lazy" decoding="async" />
	<p class="excerpt">{data.description}</p>
</a>

<style>
	.card {
		display: grid;
		grid-template: auto 1fr / auto 1fr;
		height: 12rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		color: inherit;
		font-family: var(--font-brand);
		font-size: var(--text-md);
		font-weight: 600;
		transition: box-shadow var(--theme-transition);
	}

	.card:hover {
		box-shadow: var(--shadow-md);
	}

	.badge {
		position: absolute;
		z-index: 2;
		margin: 0.5rem;
		padding: 0.25rem 0.5rem;
		background: var(--gray-999);
		color: var(--gray-200);
		border-radius: 999px;
		font-size: 0.75rem;
	}

	.title {
		grid-area: 1 / 1 / 2 / 2;
		z-index: 1;
		margin: 0.5rem 0.5rem 0 0.5rem;
		padding: 0.5rem 1rem;
		background: linear-gradient(90deg, rgba(0,0,0,0.4), rgba(0,0,0,0.0));
		color: var(--gray-100);
		border-radius: 0.375rem;
	}

	.excerpt {
		grid-area: 2 / 1 / 3 / 2;
		z-index: 2;
		padding: 0.75rem;
		color: var(--gray-300);
		font-weight: 500;
		font-size: var(--text-sm);
		background: rgba(0,0,0,0.03);
	}

	img {
		grid-area: 1 / 1 / 3 / 3;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 50em) {
		.card {
			height: 20rem;
			border-radius: 1.5rem;
		}

		.title {
			border-radius: 0.9375rem;
		}
	}
</style>
