---
import type { CollectionEntry } from 'astro:content';

interface Props {
    project: CollectionEntry<'projects'>;
}

const { data, id } = Astro.props.project;
---

<a class="card" href={`/${data.category}/${id}`}>
    <span class="badge">{data.category}</span>
    <div class="content-overlay">
        <span class="title">{data.title}</span>
        {data.description && <p class="excerpt">{data.description}</p>}
    </div>
    <img src={data.coverImage} alt={data.description || data.title} loading="lazy" decoding="async" />
</a>

<style>
    .card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        height: 12rem;
        width: 100%;
        min-width: 0;
        background: var(--gradient-subtle);
        border: 1px solid var(--gray-800);
        border-radius: 0.75rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        text-decoration: none;
        color: inherit;
        font-family: var(--font-brand);
        font-size: var(--text-md);
        font-weight: 600;
        transition: box-shadow var(--theme-transition);
    }

    .card:hover {
        box-shadow: var(--shadow-md);
    }

    .badge {
        position: absolute;
        top: 0.5rem;
        left: 0.5rem;
        z-index: 2;
        padding: 0.25rem 0.5rem;
        background: var(--gray-999);
        color: var(--gray-200);
        border-radius: 999px;
        font-size: 0.75rem;
        text-transform: capitalize;
    }

    .content-overlay {
        position: relative;
        z-index: 1;
        margin-top: auto;
        padding: 0.75rem;
        background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.85) 100%);
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .title {
        color: var(--gray-100);
    }

    .excerpt {
        color: var(--gray-300);
        font-weight: 400;
        font-size: var(--text-sm);
        margin: 0;
    }

    img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
    }

    @media (min-width: 50em) {
        .card {
            height: 20rem;
            border-radius: 1.5rem;
        }
    }
</style>